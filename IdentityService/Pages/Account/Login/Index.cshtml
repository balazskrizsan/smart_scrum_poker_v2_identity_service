@page
@model IdentityService.Pages.Login.Index
@{
    ViewData["Title"] = "Login";
    Layout = "_MainLayout";
}

<div class="container">
    <div class="row">
        <div class="col col-xl-12 col-12">
            <h2 style="margin-top: 50px;">Multi-login</h2>
        </div>
    </div>

    <partial name="_ValidationSummary" />

    <div class="row">
        @if (Model.View.EnableLocalLogin)
        {
            <div class="col col-xl-5 col-lg-6 col-md-12 col-sm-12 col-12">
                <div class="registration-login-form">
                    <div class="title h6">Local Account</div>
                    <form class="content" asp-page="/Account/Login/Index">
                        <input type="hidden" asp-for="Input.ReturnUrl" />

                        <div class="row">
                            <div class="col col-12 col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                <div class="form-group label-floating">
                                    <label class="control-label" asp-for="Input.Email"></label>
                                    <input class="form-control" placeholder="" asp-for="Input.Email" autofocus>
                                </div>
                                <div class="form-group label-floating">
                                    <label class="control-label" asp-for="Input.Password"></label>
                                    <input type="password" class="form-control" placeholder="" asp-for="Input.Password" autocomplete="off">
                                </div>

                                @if (Model.View.AllowRememberLogin)
                                {
                                    <div class="remember">
                                        <div class="checkbox">
                                            <label>
                                                <input asp-for="Input.RememberLogin"><span class="checkbox-material"><span class="check"></span></span>
                                                Remember password
                                            </label>
                                        </div>
                                    </div>
                                }

                                <button class="btn btn-lg btn-primary full-width" name="Input.Button" value="login">Login</button>

                                <p>Don't have an account? <a asp-page="/Account/Register/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Register here</a></p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (!Model.View.EnableLocalLogin && !Model.View.VisibleExternalProviders.Any())
        {
            <div class="alert alert-warning">
                <strong>Invalid login request</strong>
                There are no login schemes configured for this request.
            </div>
        }

        @if (Model.View.EnableLocalLogin)
        {
            <div class="col col-xl-5 col-lg-6 col-md-12 col-sm-12 col-12">
                <div class="registration-login-form">
                    <div class="title h6">Quick Register</div>
                    <form class="content" asp-page="/Account/Login/Index">
                        <input type="hidden" asp-for="QuickRegisterInput.ReturnUrl" />

                        <div class="row">
                            <div class="col col-12 col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                <div class="form-group label-floating">
                                    <label class="control-label" asp-for="QuickRegisterInput.Nickname"></label>
                                    <input class="form-control" placeholder="" asp-for="QuickRegisterInput.Nickname">
                                </div>
                                <div class="form-group label-floating">
                                    <label class="control-label" asp-for="QuickRegisterInput.Email"></label>
                                    <input class="form-control" placeholder="" asp-for="QuickRegisterInput.Email">
                                </div>

                                <button class="btn btn-purple btn-lg full-width" name="QuickRegisterInput.Button" value="quickregister" autofocus>Quick register</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.View.VisibleExternalProviders.Any())
        {
            <div class="col-sm-4">
                <div class="card">
                    <div class="card-header">
                        <h2>External Account</h2>
                    </div>
                    <div class="card-body">
                        <ul class="list-inline">
                            @foreach (var provider in Model.View.VisibleExternalProviders)
                            {
                                <li class="list-inline-item">
                                    <a class="btn btn-secondary">Disabled</a>
                                    @* <a class="btn btn-secondary" *@
                                    @* asp-page="/ExternalLogin/Challenge" *@
                                    @* asp-route-scheme="@provider.AuthenticationScheme" *@
                                    @* asp-route-returnUrl="@Model.Input.ReturnUrl"> *@
                                    @* @provider.DisplayName *@
                                    @* </a> *@
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
